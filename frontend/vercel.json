{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://18.141.167.113:5000/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "http://18.141.167.113:5000/auth/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://18.141.167.113:5000/uploads/:path*"
    },
    {
      "source": "/downloads/:path*",
      "destination": "http://18.141.167.113:5000/downloads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model lecturers {
  id                    Int                     @id @default(autoincrement())
  lecturer_code         String                  @unique @db.VarChar(10)
  fullname_th           String
  fullname_en           String?
  position_th           String?
  position_en           String?
  email                 String?                 @db.VarChar(150)
  tel                   String?                 @db.VarChar(100)
  education_th          String?
  education_en          String?
  image_path            String?
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  orcid                 String?                 @db.VarChar(50)
  scholar_name          String?
  research_publications research_publications[]
  embedding  Unsupported("vector")?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model faq {
  id         Int                    @id @default(autoincrement())
  question   String
  answer     String
  category   String?                @db.VarChar(100)
  status     String                 @default("active") @db.VarChar(20)
  created_at DateTime?              @default(now()) @db.Timestamp(6)
  updated_at DateTime               @updatedAt
  embedding  Unsupported("vector")?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model news {
  id         Int       @id @default(autoincrement())
  title      String    @db.VarChar(255)
  content    String
  category   String    @db.VarChar(100)
  status     String    @default("active") @db.VarChar(20)
  image      String?
  slug       String?   @unique
  start_date DateTime  @db.Date
  end_date   DateTime? @db.Date

  created_by Int
  created_at DateTime  @default(now()) @db.Timestamp(6)

  users      users     @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cr_by")
}

model research_publications {
  id               Int        @id @default(autoincrement())
  lecturer_id      Int?
  title            String
  authors          String?
  publication_type String?    @db.VarChar(30)
  venue            String?
  publication_year Int?
  volume           String?    @db.VarChar(50)
  issue            String?    @db.VarChar(50)
  pages            String?    @db.VarChar(50)
  doi              String?
  url              String?
  abstract         String?
  external_source  String?    @db.VarChar(50)
  external_id      String?
  is_auto_imported Boolean?   @default(false)
  is_published     Boolean?   @default(true)
  created_at       DateTime?  @default(now()) @db.Timestamp(6)
  updated_at       DateTime?  @default(now()) @db.Timestamp(6)
  lecturers        lecturers? @relation(fields: [lecturer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  embedding Unsupported("vector")?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id         Int      @id @default(autoincrement())
  email      String   @unique @db.VarChar(255)
  username   String?  @db.VarChar(100)
  full_name  String   @db.VarChar(255)

  role       String   @default("lecturer") @db.VarChar(50)

  person_key String?  @db.VarChar(50)

  created_at DateTime @default(now())

  news       news[]
}

model downloads {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  file_path   String
  category    String?   @db.VarChar(100)
  created_at  DateTime  @default(now())
  file_type   String?
}

model staff {
  id          Int      @id @default(autoincrement())
  staff_code  String?  @unique
  fullname_th String
  fullname_en String?
  position_th String?
  position_en String?
  email       String?  @db.VarChar(150)
  image_path  String?
  created_at  DateTime @default(now()) @db.Timestamp(6)
}

model degrees {
  id        Int    @id @default(autoincrement())
  name_th   String
  slug      String @unique

  programs  programs[]
}

model programs {
  id        Int    @id @default(autoincrement())
  degreeId  Int
  name_th   String
  slug      String

  degree    degrees @relation(fields: [degreeId], references: [id])
  versions  program_versions[]
}

model program_versions {
  id        Int    @id @default(autoincrement())
  programId Int
  year      Int
  pdf_url   String?

  program   programs @relation(fields: [programId], references: [id])
  sections  program_sections[]

  @@unique([programId, year])
}

model program_sections {
  id          Int    @id @default(autoincrement())
  versionId   Int
  section_no  Int
  title       String
  content     String @db.Text
  order_index Int

  version     program_versions @relation(fields: [versionId], references: [id])
}
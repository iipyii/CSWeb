generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model lecturers {
  id                    Int                     @id @default(autoincrement())
  lecturer_code         String                  @unique @db.VarChar(10)
  fullname_th           String
  fullname_en           String?
  position_th           String?
  position_en           String?
  email                 String?                 @db.VarChar(150)
  tel                   String?                 @db.VarChar(100)
  education_th          String?
  education_en          String?
  image_path            String?
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  orcid                 String?                 @db.VarChar(50)
  scholar_name          String?
  research_publications research_publications[]
  embedding             Unsupported("vector")?
  advisors              advisors[]
  projects              projects[]              @relation("main_advisor_projects")
  co_projects           projects[]              @relation("co_advisor_projects")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model faq {
  id         Int                    @id @default(autoincrement())
  question   String
  answer     String
  category   String?                @db.VarChar(100)
  status     String                 @default("active") @db.VarChar(20)
  created_at DateTime?              @default(now()) @db.Timestamp(6)
  updated_at DateTime               @updatedAt
  embedding  Unsupported("vector")?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model news {
  id         Int       @id @default(autoincrement())
  title      String    @db.VarChar(255)
  content    String
  category   String    @db.VarChar(100)
  status     String    @default("active") @db.VarChar(20)
  image      String?

  additional_images String[] // เก็บรายชื่อไฟล์รูปภาพเพิ่มเติม
  attachments       String[] // เก็บรายชื่อไฟล์เอกสารแนบ
  summary           String?   @db.Text
  
  slug       String?   @unique
  start_date DateTime?  @db.Date
  end_date   DateTime? @db.Date
  
  is_urgent         Boolean  @default(false)
  created_by Int
  created_at DateTime @default(now()) @db.Timestamp(6)

  users users @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cr_by")
}

model research_publications {
  id               Int                    @id @default(autoincrement())
  lecturer_id      Int?
  title            String
  authors          String?
  publication_type String?                @db.VarChar(30)
  venue            String?
  publication_year Int?
  volume           String?                @db.VarChar(50)
  issue            String?                @db.VarChar(50)
  pages            String?                @db.VarChar(50)
  doi              String?
  url              String?
  abstract         String?
  external_source  String?                @db.VarChar(50)
  external_id      String?
  is_auto_imported Boolean?               @default(false)
  is_published     Boolean?               @default(true)
  created_at       DateTime?              @default(now()) @db.Timestamp(6)
  updated_at       DateTime?              @default(now()) @db.Timestamp(6)
  lecturers        lecturers?             @relation(fields: [lecturer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  embedding        Unsupported("vector")?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id        Int     @id @default(autoincrement())
  email     String  @unique @db.VarChar(255)
  username  String? @db.VarChar(100)
  full_name String  @db.VarChar(255)

  role String @default("lecturer") @db.VarChar(50)

  person_key String? @db.VarChar(50)

  created_at DateTime @default(now())

  news news[]
}

model downloads {
  id         Int      @id @default(autoincrement())
  title      String
  file_path  String
  file_name  String?  // ชื่อไฟล์เดิมที่อัปโหลด
  file_type  String?
  audience   String // staff | student
  category   String // internship | thesis | csb | graduate etc
  created_at DateTime @default(now())
}

model staff {
  id          Int      @id @default(autoincrement())
  staff_code  String?  @unique
  fullname_th String
  fullname_en String?
  position_th String?
  position_en String?
  email       String?  @db.VarChar(150)
  image_path  String?
  created_at  DateTime @default(now()) @db.Timestamp(6)
}

model degrees {
  id      Int    @id @default(autoincrement())
  name_th String
  slug    String @unique

  programs programs[]
}

model programs {
  id       Int    @id @default(autoincrement())
  degreeId Int
  name_th  String
  slug     String

  degree   degrees            @relation(fields: [degreeId], references: [id])
  versions program_versions[]
}

model program_versions {
  id        Int     @id @default(autoincrement())
  programId Int
  year      Int
  pdf_url   String?

  program  programs           @relation(fields: [programId], references: [id])
  sections program_sections[]

  @@unique([programId, year])
}

model program_sections {
  id          Int     @id @default(autoincrement())
  versionId   Int
  section_no  Int
  title       String
  content     String  @db.Text
  order_index Int
  pdf_path    String?
  xml_data    String? @db.Xml

  version program_versions @relation(fields: [versionId], references: [id])
}

model advisors {
  id         Int    @id @default(autoincrement())
  lecturerId Int
  level      String
  year       Int

  lecturer         lecturers          @relation(fields: [lecturerId], references: [id])
  advisor_students advisor_students[]

  @@unique([lecturerId, year, level])
}

model students {
  id Int @id @default(autoincrement())

  student_id String  @unique
  title      String
  firstname  String
  lastname   String
  room       String?
  year       Int?     // ชั้นปี หรือ ปีการศึกษาที่เข้าเรียน
  projects   projects[]

  advisor_students advisor_students[]

  @@index([firstname])
  @@index([lastname])
  @@index([student_id])
}

model advisor_students {
  id Int @id @default(autoincrement())

  studentId Int
  advisorId Int

  student students @relation(fields: [studentId], references: [id])
  advisor advisors @relation(fields: [advisorId], references: [id])

  @@unique([studentId, advisorId])
}

model internships {
  id        Int     @id @default(autoincrement())
  section   String // เช่น "คุณสมบัติ", "ขั้นตอนสมัคร", "เอกสาร"
  title     String
  content   String  @db.Text
  embedding String?
}

model course_documents {
  id        Int    @id @default(autoincrement())
  year_id   Int
  semester  Int
  category  String
  title     String
  file_path String
  order_no  Int?

  year course_years @relation(fields: [year_id], references: [id])
}

model course_years {
  id   Int @id @default(autoincrement())
  year Int @unique

  course_documents course_documents[]
}

model CourseKnowledge {
  id          Int      @id @default(autoincrement())
  course_code String
  title_th    String
  content     String   @db.Text 
  embedding   Unsupported("vector(384)")? 
}

model GeneralKnowledge {
  id          Int      @id @default(autoincrement())
  category    String   // หมวดหมู่ เช่น "อาจารย์", "สถานที่", "ระเบียบการ", "ข่าวสาร"
  topic       String   // หัวข้อ เช่น "ข้อมูลติดต่อ ผศ.ดร.สมชาย"
  content     String   @db.Text // เนื้อหาเต็มๆ
  embedding   Unsupported("vector(384)")? 
}

model TeacherKnowledge {
  id          Int      @id @default(autoincrement())
  name        String   // ชื่อ-นามสกุลอาจารย์
  content     String   @db.Text // ข้อมูลรวมๆ (ความเชี่ยวชาญ, ห้องพัก, อีเมล)
  embedding   Unsupported("vector(384)")? 
}

model banners {
  id         Int      @id @default(autoincrement())
  title      String?  @db.VarChar(255)
  image_path String   @db.Text
  link_url   String?  @db.Text
  is_active  Boolean  @default(true)
  order_no   Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamp(6)
}

model site_config {
  id           Int      @id @default(autoincrement())
  config_key   String   @unique @db.VarChar(100) // เช่น "site_logo", "site_name"
  config_value String   @db.Text
  description  String?  @db.VarChar(255)
  updated_at   DateTime @updatedAt
}

model projects {
  id           Int      @id @default(autoincrement())
  title_th     String   @db.VarChar(255)
  title_en     String?  @db.VarChar(255)
  abstract     String?  @db.Text
  year         Int?     // ปีการศึกษาที่ทำโปรเจกต์
  semester     Int?     @default(1) // ภาคการศึกษา เช่น 1, 2
  image_path   String?  @db.Text
  document_url String?  @db.Text // ลิงก์ไฟล์เล่มปริญญานิพนธ์
  github_url   String?  @db.Text // ลิงก์ Source Code (ถ้ามี)
  students_text String? @db.Text // รายชื่อนักศึกษาผู้จัดทำ (รองรับหลายคน)
  
  student_id   Int?
  advisor_id   Int?
  co_advisor_id Int?
  
  created_at   DateTime @default(now()) @db.Timestamp(6)

  // ความสัมพันธ์
  student      students?  @relation(fields: [student_id], references: [id])
  advisor      lecturers? @relation("main_advisor_projects", fields: [advisor_id], references: [id])
  co_advisor   lecturers? @relation("co_advisor_projects", fields: [co_advisor_id], references: [id])
}

model subjects {
  id              Int       @id @default(autoincrement())
  subject_code    String    @db.VarChar(20)
  title_th        String    @db.VarChar(255)
  title_en        String    @db.VarChar(255)
  prereq1         String?   @db.VarChar(50)
  prereq2         String?   @db.VarChar(50)
  credit          String    @db.VarChar(30)
  description_th  String    @db.Text
  description_en  String?   @db.Text
  category        String?   @db.VarChar(100) // เช่น "หมวดวิชาเฉพาะด้านบังคับ", "หมวดวิชาเลือก", "หมวดวิชาศึกษาทั่วไป"
  curriculum_code String    @db.VarChar(50)  // เช่น "CS69", "CS64", "CS59", "CS-Inter64", "MS-CS67", "MS-CS62", "MS-SE59", "PhD-CS64", "PhD-CS59"
  curriculum_year Int       @default(2564)   // 2569, 2564, 2559, etc.
  degree_level    String    @default("bachelor") @db.VarChar(30) // bachelor, master, doctor
  track           String?   @db.VarChar(100) // เช่น "Software Engineering & Cloud", "Data Science & Artificial Intelligence", "Network & Cybersecurity", "IoT & Intelligent Systems", "ทั่วไป"
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @updatedAt

  @@index([subject_code])
  @@index([curriculum_code])
  @@index([track])
}

model student_handbooks {
  id               Int       @id @default(autoincrement())
  category         String    @db.VarChar(100) // เช่น "ระเบียบการศึกษา", "การลงทะเบียน", "การฝึกงานและสหกิจศึกษา", "เกณฑ์สำเร็จการศึกษา", "ทุนการศึกษา", "ชีวิตในรั้วมหาวิทยาลัย"
  topic            String    @db.VarChar(255)
  content          String    @db.Text
  applicable_years String?   @db.VarChar(50)  // เช่น "ทุกชั้นปี", "ปี 1", "ปี 4"
  degree_level     String?   @default("all") @db.VarChar(30) // all, bachelor, master, doctor
  file_url         String?   @db.Text
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @updatedAt

  @@index([category])
}
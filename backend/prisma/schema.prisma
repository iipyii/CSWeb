generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model users {
  id         Int      @id @default(autoincrement())
  email      String   @unique @db.VarChar(255)
  username   String?  @db.VarChar(100)
  full_name  String   @db.VarChar(255)

  role String @default("lecturer") @db.VarChar(50)

  person_key String? @db.VarChar(50)

  created_at DateTime @default(now())

  news     news[]
  lecturer lecturers?
  staff    staff?
}

model lecturers {
  id                    Int                     @id @default(autoincrement())
  lecturer_code         String                  @unique @db.VarChar(10)
  fullname_th           String
  fullname_en           String?
  position_th           String?
  position_en           String?
  email                 String?                 @db.VarChar(150)
  tel                   String?                 @db.VarChar(100)
  education_th          String?
  education_en          String?
  image_path            String?
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  orcid                 String?                 @db.VarChar(50)
  scholar_name          String?
  user_id               Int?                    @unique
  users                 users?                  @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  research_publications research_publications[]
  embedding             Unsupported("vector")?
  advisor               advisor[]
  projects              projects[]
}

model staff {
  id          Int      @id @default(autoincrement())
  staff_code  String?  @unique
  fullname_th String
  fullname_en String?
  position_th String?
  position_en String?
  email       String?  @db.VarChar(150)
  image_path  String?
  created_at  DateTime @default(now()) @db.Timestamp(6)
  user_id     Int?     @unique
  users       users?   @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

/// renamed from faq
model faqs {
  id         Int                    @id @default(autoincrement())
  question   String
  answer     String
  category   String?                @db.VarChar(100)
  status     String                 @default("active") @db.VarChar(20)
  created_at DateTime?              @default(now()) @db.Timestamp(6)
  updated_at DateTime               @updatedAt
  embedding  Unsupported("vector")?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model news {
  id         Int       @id @default(autoincrement())
  title      String    @db.VarChar(255)
  content    String
  category   String    @db.VarChar(100)
  status     String    @default("active") @db.VarChar(20)
  image      String?

  additional_images String[] // เก็บรายชื่อไฟล์รูปภาพเพิ่มเติม
  attachments       String[] // เก็บรายชื่อไฟล์เอกสารแนบ

  slug       String?   @unique
  start_date DateTime?  @db.Date
  end_date   DateTime? @db.Date

  is_urgent         Boolean  @default(false)
  created_by Int
  created_at DateTime @default(now()) @db.Timestamp(6)

  users users @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cr_by")
}

model research_publications {
  id               Int                    @id @default(autoincrement())
  lecturer_id      Int?
  title            String
  authors          String?
  publication_type String?                @db.VarChar(30)
  venue            String?
  publication_year Int?
  volume           String?                @db.VarChar(50)
  issue            String?                @db.VarChar(50)
  pages            String?                @db.VarChar(50)
  doi              String?
  url              String?
  abstract         String?
  external_source  String?                @db.VarChar(50)
  external_id      String?
  is_auto_imported Boolean?               @default(false)
  is_published     Boolean?               @default(true)
  created_at       DateTime?              @default(now()) @db.Timestamp(6)
  updated_at       DateTime?              @default(now()) @db.Timestamp(6)
  lecturers        lecturers?             @relation(fields: [lecturer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  embedding        Unsupported("vector")?
}

model downloads {
  id         Int      @id @default(autoincrement())
  title      String
  file_path  String
  file_type  String?
  audience   String // staff | student
  category   String // internship | thesis | csb | graduate etc
  created_at DateTime @default(now())
}

model degrees {
  id      Int    @id @default(autoincrement())
  name_th String
  slug    String @unique

  programs programs[]
}

model programs {
  id       Int    @id @default(autoincrement())
  degreeId Int
  name_th  String
  slug     String

  degree      degrees       @relation(fields: [degreeId], references: [id])
  curriculums curriculums[]
}

/// renamed from program_versions
model curriculums {
  id        Int     @id @default(autoincrement())
  programId Int
  year      Int
  pdf_url   String?

  program  programs   @relation(fields: [programId], references: [id])
  courses  courses[]
  students students[]

  @@unique([programId, year])
}

/// renamed from program_sections
model courses {
  id           Int     @id @default(autoincrement())
  curriculumId Int
  section_no   Int
  title        String
  content      String  @db.Text
  order_index  Int
  pdf_path     String?
  xml_data     String? @db.Xml

  curriculum curriculums @relation(fields: [curriculumId], references: [id])
}

/// collapses advisors + advisor_students into one flat assignment row per (lecturer, student, year)
model advisor {
  id            Int    @id @default(autoincrement())
  lecturer_id   Int
  student_id    Int
  academic_year Int
  level         String

  lecturer lecturers @relation(fields: [lecturer_id], references: [id])
  student  students  @relation(fields: [student_id], references: [id])

  @@unique([lecturer_id, student_id, academic_year])
}

model students {
  id Int @id @default(autoincrement())

  student_id String  @unique
  title      String
  firstname  String
  lastname   String
  room       String?
  year       Int?     // ชั้นปี หรือ ปีการศึกษาที่เข้าเรียน
  level      String?

  curriculum_id Int?
  curriculum    curriculums? @relation(fields: [curriculum_id], references: [id])

  advisor         advisor[]
  project_members project_members[]

  @@index([firstname])
  @@index([lastname])
  @@index([student_id])
}

model internships {
  id        Int     @id @default(autoincrement())
  section   String // เช่น "คุณสมบัติ", "ขั้นตอนสมัคร", "เอกสาร"
  title     String
  content   String  @db.Text
  embedding String?
}

model course_documents {
  id        Int    @id @default(autoincrement())
  year_id   Int
  semester  Int
  category  String
  title     String
  file_path String
  order_no  Int?

  year course_years @relation(fields: [year_id], references: [id])
}

model course_years {
  id   Int @id @default(autoincrement())
  year Int @unique

  course_documents course_documents[]
}

/// replaces CourseKnowledge / GeneralKnowledge / TeacherKnowledge
model student_handbooks {
  id               Int                          @id @default(autoincrement())
  category         String   // หมวดหมู่ เช่น "การลงทะเบียน", "การฝึกงาน"
  topic            String   // หัวข้อ เช่น "เงื่อนไขจบการศึกษา"
  content          String                       @db.Text
  condition_detail String?                      @db.Text
  embedding        Unsupported("vector(384)")?
}

/// replaces CourseKnowledge / GeneralKnowledge / TeacherKnowledge — generic RAG store with a
/// polymorphic pointer (source_type names the source table, reference_id its row id)
model chatbot_knowledge {
  id           Int                          @id @default(autoincrement())
  source_type  String                       @db.VarChar(50) // เช่น "course", "news", "faq", "handbook"
  reference_id Int?
  content      String                       @db.Text
  embedding    Unsupported("vector(384)")?

  @@index([source_type])
}

model banners {
  id         Int      @id @default(autoincrement())
  title      String?  @db.VarChar(255)
  image_path String   @db.Text
  link_url   String?  @db.Text
  is_active  Boolean  @default(true)
  order_no   Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamp(6)
}

model site_config {
  id           Int      @id @default(autoincrement())
  config_key   String   @unique @db.VarChar(100) // เช่น "site_logo", "site_name"
  config_value String   @db.Text
  description  String?  @db.VarChar(255)
  updated_at   DateTime @updatedAt
}

model projects {
  id           Int      @id @default(autoincrement())
  title_th     String   @db.VarChar(255)
  title_en     String?  @db.VarChar(255)
  abstract     String?  @db.Text
  year         Int?     // ปีการศึกษาที่ทำโปรเจกต์
  image_path   String?  @db.Text
  document_url String?  @db.Text // ลิงก์ไฟล์เล่มปริญญานิพนธ์
  github_url   String?  @db.Text // ลิงก์ Source Code (ถ้ามี)

  advisor_id   Int?

  created_at   DateTime @default(now()) @db.Timestamp(6)

  // ความสัมพันธ์
  advisor         lecturers?        @relation(fields: [advisor_id], references: [id])
  project_members project_members[]
}

/// joins projects to their student members (a project can have multiple students)
model project_members {
  id         Int @id @default(autoincrement())
  project_id Int
  student_id Int

  project projects @relation(fields: [project_id], references: [id], onDelete: Cascade)
  student students @relation(fields: [student_id], references: [id])

  @@unique([project_id, student_id])
}
